Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:app|database|scripts|tests|docs|backups)(?:/|$) - [F,L,NC]
  RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "(?i)(?:^\.env|\.sql(?:\.(?:gz|zip))?$|\.bak$|\.backup$|\.log$|\.ini$|\.ya?ml$|composer\.(?:json|lock)$|package(?:-lock)?\.json$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
